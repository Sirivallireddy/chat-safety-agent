# Copy this file to .env and fill in your key. Never commit .env.

# Chat model + demo safety judge: any OpenAI-compatible API
# Gemini: LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/  LLM_MODEL=gemini-3.1-flash-lite
# Groq:   LLM_BASE_URL=https://api.groq.com/openai/v1                        LLM_MODEL=llama-3.3-70b-versatile
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile

# Which Chat Safety evaluator to use: llm | jev | offline
SAFETY_PROVIDER=llm

# Only for SAFETY_PROVIDER=jev (their real model, via OpenRouter Decisions API)
SAFETY_API_KEY=
SAFETY_MODEL=typesafe/jev-1.14
SAFETY_DECISIONS_ENDPOINT=https://openrouter.ai/api/alpha/decisions
